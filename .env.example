# Fonte de dados do app.
#   local    -> tudo neste navegador (localStorage + IndexedDB). Padrao. Nao precisa de mais nada.
#   supabase -> backend real. Exige as 3 chaves abaixo e os SQL de supabase/ aplicados no Dashboard.
VITE_DATA_PROVIDER=local

# Só use quando VITE_DATA_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Id da empresa-cliente (uma unica empresa por enquanto). Deixe o padrao no modo local.
VITE_EMPRESA_ID=00000000-0000-0000-0000-000000000001
